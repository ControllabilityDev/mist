!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# EPIC-03 scan battery work area: generated rulesets, raw scanner output,
# SBOMs and the assembled envelope. Generated, never committed -- a committed
# gitleaks config is what the no-suppression assertion forbids.
build/
scan-run.json

# EPIC-02: the local sqlite database. Synthetic rows only, but generated --
# regenerate with `npm run seed`, never commit.
dev.db
prisma/dev.db
*.db-journal

# EPIC-07: the tarball vault. 635.5 MiB, measured. Distributed as a GitHub
# release asset rather than Git LFS -- LFS would eat two thirds of the free
# quota on day one and be re-fetched by every clone. Rebuild it with
# `node scripts/vault.mjs build decay/v1.0.0`; verify with `check`.
decay/*/vault/
