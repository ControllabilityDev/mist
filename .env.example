# The weather provider key. 32 hex characters (OpenWeatherMap shape).
# See docs/KEY_ROTATION.md: K1 is committed deliberately and then revoked; K2
# lives only here and in the deployment environment, never in git.
WEATHER_API_KEY=
NEXT_PUBLIC_WEATHER_API_KEY=

WEATHER_PROVIDER_URL=https://api.openweathermap.org/data/2.5
NEXT_PUBLIC_GEO_URL=https://api.openweathermap.org/geo/1.0/direct

API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=4000

DATABASE_URL="file:./dev.db"
